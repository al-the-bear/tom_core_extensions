# ==============================================================================
# Comprehensive .gitignore for multi-language development
# Languages: Dart, TypeScript, JavaScript, Python, Rust, Go
# Includes: VS Code extension development, Flutter
# ==============================================================================

# ==============================================================================
# GENERAL / CROSS-PLATFORM
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor/IDE
*.swp
*.swo
*~
.idea/
*.iml
*.ipr
*.iws
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
*.sublime-project
*.sublime-workspace

# Logs and databases
*.log
*.sql
# Reference DDL migrations shipped as example artifacts are tracked despite *.sql
!**/example/**/migrations/**/*.sql
# Server-sample migration trees are deliverables (schema + seed), not local DBs
!**/database_migrations/**/*.sql
# SQL under a test fixtures folder is committed input, not a local DB dump —
# migration trees for the engine, and the convergence check's chains.
!**/test/fixtures/**/*.sql
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.temp
*.bak
*.backup
tmp/
temp/
ztmp/

