# ==============================================================================
# PROJECT-SPECIFIC EXCLUSIONS
# ==============================================================================

# AI trail files (keep .gitkeep)
_ai/**/trail/*
!_ai/**/trail/.gitkeep

# Chat replies
_ai/chat_replies/

# Legacy config files
bk_master.yaml

# Metadata backup
.tom_metadata_backup/

# Info files
*.info

# Local development folders (repo-specific - add as needed)
# /some_local_folder/

# Analyzer summary caches generated by tom_analyzer_shared. These `.sum`
# bundles are regenerable, analyzer-version-specific build artifacts keyed by
# `package@version`. Tracking them poisons the cache on every analyzer upgrade
# (an analyzer-8 bundle is undecodable by analyzer 10's bundle_reader ->
# RangeError in _readDirectiveUri) and bloats the repo. They regenerate on
# demand.
**/.tom/analyzer-cache/

# Test run logs, baselines and analysis — machine-generated, never versioned.
# These live in a `testlog/` folder next to each project's `doc/` folder.
# The `doc/` folder itself is fully tracked (no test artifacts written there).
**/testlog/
